{
  "name": "blobmascot",
  "version": "0.2.0",
  "description": "Interactive blob mascot for React apps. Shape, expression, and gaze update live on canvas.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Listiananda Apriliawan",
    "url": "https://naandalist.com",
    "username": "naandalist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naandalist/blobmascot.git"
  },
  "bugs": {
    "url": "https://github.com/Naandalist/blobmascot/issues"
  },
  "homepage": "https://github.com/Naandalist/blobmascot#readme",
  "website": "https://naandalist.com",
  "keywords": [
    "react",
    "mascot",
    "blob",
    "bloub",
    "avatar",
    "animation",
    "procedural",
    "morphing",
    "expression",
    "gaze",
    "virtual-assistant",
    "gamification",
    "onboarding"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsup",
    "build:playground": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
